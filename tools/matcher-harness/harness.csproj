<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HanglineHarness</RootNamespace>
    <AssemblyName>harness</AssemblyName>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只编匹配器本体。它的日志依赖用本地桩替代，避免把整个界面层拉进来。 -->
    <Compile Include="..\..\src\Hangline\FrameMatcher.cs" Link="FrameMatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>
